{
  "name": "@panth977/agentation-svelte",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Visual feedback for AI coding agents — Svelte 5 port of benjitaylor/agentation",
  "license": "PolyForm-Shield-1.0.0",
  "author": "Panth977 (Svelte port) — original: Benji Taylor (https://github.com/benjitaylor/agentation)",
  "homepage": "https://github.com/Panth977/agentation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panth977/agentation.git"
  },
  "bugs": {
    "url": "https://github.com/Panth977/agentation/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "agentation",
    "ai",
    "ai-agents",
    "annotations",
    "visual-feedback",
    "feedback"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "playwright-core": "^1.61.0",
    "publint": "^0.2.0",
    "sass": "^1.97.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
